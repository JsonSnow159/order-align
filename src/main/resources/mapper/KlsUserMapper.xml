<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.orderalign.mapper.KlsUserMapper">

    <resultMap id="BaseResultMap" type="com.example.orderalign.model.KlsUser">
        <id column="id" jdbcType="BIGINT" property="id"/>
        <result column="yz_open_id" jdbcType="VARCHAR" property="yzOpenId"/>
        <result column="mobile" jdbcType="VARCHAR" property="mobile"/>
        <result column="out_open_id" jdbcType="VARCHAR" property="outOpenId"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, yz_open_id, mobile, out_open_id
    </sql>

    <select id="findAll" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM kls_user limit 50
    </select>

    <select id="selectByMobile" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM kls_user
        WHERE mobile = #{mobile, jdbcType=VARCHAR}
    </select>

    <select id="selectByYzOpenId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM kls_user
        WHERE yz_open_id = #{yzOpenId, jdbcType=VARCHAR}
    </select>

    <select id="selectByOutOpenId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM kls_user
        WHERE out_open_id = #{outOpenId, jdbcType=VARCHAR}
    </select>
</mapper>
